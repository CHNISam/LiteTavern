# LiteTavern — open client (apps/web)
#
# The hosted service and its configuration now live in the LiteTavern Cloud
# repository. Everything below is build-time and public: Vite inlines these into
# the bundle, so never put a secret here.

# Where the static client finds LiteTavern Cloud. Leave unset for same-origin.
# Also added to the built page's CSP connect-src.
# VITE_CLOUD_BASE_URL=https://cloud.your-domain.example

# Extra BYOK provider origins this build may talk to, beyond the built-in ones
# in apps/web/src/lib/byok-origins.ts. Space- or comma-separated origins.
# BYOK runs straight from the browser, so each entry lands in two places at
# once: the origin allowlist in the bundle, and the built page's CSP
# connect-src. An origin missing here cannot be used, by design — never widen
# this to "any HTTPS origin".
# Vite reads .env from apps/web, so for local development put this in
# apps/web/.env.local; deployments get it from a repository variable.
# VITE_BYOK_CONNECT_ORIGINS=https://api.example.com

# Sub-path deployments (e.g. GitHub Pages project sites):
# VITE_BASE_PATH=/LiteTavern/

# Only GitHub Pages builds need a generated 404.html SPA fallback.
# VITE_DEPLOY_TARGET=github-pages

# Public voluntary-support link (safe public URL only). Left unset, this falls
# back to the project's published Afdian page.
VITE_SUPPORT_AFDIAN_URL=
