# LiteTavern API/Web
# The POMCHAT_* names are the historical ones and are kept for compatibility;
# renaming them would break existing deployments.
NODE_ENV=development
POMCHAT_WEB_ORIGIN=http://127.0.0.1:5173
POMCHAT_DATA_DIR=.pomchat/database
POMCHAT_ASSET_DIR=.pomchat/assets

# ===== LiteTavern Cloud =====
# Which testing stage the hosted service is in. Not a pricing tier.
CLOUD_STAGE=ALPHA

# LiteTavern Cloud Trial — the one-time allowance an anonymous visitor receives.
# FREE_QUOTA_* are the historical names for it and keep their meaning.
FREE_QUOTA_ENABLED=true
FREE_QUOTA_INITIAL_COUNT=30

# Default Alpha quota policy. Each Alpha batch may override any of these; the batch
# row is authoritative, this is only the fallback for batches that do not say.
CLOUD_ALPHA_CYCLE_UNITS=300
CLOUD_ALPHA_CYCLE_DAYS=30
CLOUD_ALPHA_CARRY_OVER=false
CLOUD_ALPHA_MAX_UNITS_PER_REQUEST=4
# 0 disables the per-day cap.
CLOUD_ALPHA_DAILY_UNIT_LIMIT=60
CLOUD_ALPHA_USER_RATE_LIMIT_PER_MINUTE=20
# Optional per-model multipliers, e.g. {"groq:llama-3.3-70b-versatile": 2}
# CLOUD_ALPHA_MODEL_MULTIPLIERS={}

# Real-cost accounting. USD per 1M tokens, keyed by "provider:model" or "model".
# Without this, cost columns are recorded as 0 — honest "not measured", not a guess.
# CLOUD_MODEL_PRICES={"groq:llama-3.3-70b-versatile":{"input":0.59,"output":0.79}}

# Global monthly spend ceiling for platform-paid calls. 0 disables the breaker.
# When reached, hosted model calls stop; BYOK keeps working.
CLOUD_GLOBAL_MONTHLY_BUDGET_USD=0

# Support entry. Disabled until an operator sets a URL; not tied to any one platform.
# Contributions are confirmed manually — there is no payment webhook in this build.
CLOUD_SUPPORT_ENABLED=false
# CLOUD_SUPPORT_URL=https://your-support-page.example
# CLOUD_SUPPORT_HEADLINE=支持 LiteTavern
# CLOUD_SUPPORT_BODY=你的贡献将用于 LiteTavern Cloud 的模型额度、服务器和持续开发。
CLOUD_SUPPORT_THANKS_LIST=false

# Operator API. Empty (the default) makes every /v1/cloud/admin/* route return 404.
# CLOUD_ADMIN_TOKEN=

# Backups. Run with the API stopped; see docs/v0.1.0/architecture/litetavern-cloud.md
CLOUD_BACKUP_DIR=.pomchat/backups
CLOUD_BACKUP_KEEP_DAYS=14
FREE_PROVIDER_PRIMARY=groq
FREE_PROVIDER_FALLBACK=cloudflare
FREE_PROVIDER_TIMEOUT_MS=30000

# Groq (server-side only)
GROQ_ENABLED=true
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile

# Cloudflare Workers AI (server-side only)
CLOUDFLARE_ENABLED=true
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_MODEL=@cf/meta/llama-3.1-8b-instruct
# Optional override:
# CLOUDFLARE_BASE_URL=https://api.cloudflare.com/client/v4/accounts/ACCOUNT_ID/ai/v1

# Basic abuse and capacity protection (single API process, per minute)
FREE_PROVIDER_USER_RATE_LIMIT_PER_MINUTE=12
FREE_PROVIDER_IP_RATE_LIMIT_PER_MINUTE=30
FREE_PROVIDER_GLOBAL_RATE_LIMIT_PER_MINUTE=600
FREE_PROVIDER_GLOBAL_CONCURRENCY=32

# Metric callers may override this threshold per query.
ANALYTICS_EFFECTIVE_CHAT_TURNS=3

# Public voluntary-support page (build-time, safe public URLs only)
VITE_SUPPORT_WECHAT_QR_URL=
VITE_SUPPORT_AFDIAN_URL=
VITE_SUPPORT_BILIBILI_URL=
VITE_SUPPORT_DOUYIN_URL=

# Email verification-code login/sync.
# EMAIL_PROVIDER: "console" (dev — prints the code to the server log) or "http".
# Production defaults to "http" and requires the EMAIL_HTTP_* + EMAIL_FROM_ADDRESS
# settings below; without them the code is never delivered.
EMAIL_PROVIDER=console
# EMAIL_HTTP_ENDPOINT=https://api.your-mail-provider.example/v1/send
# EMAIL_HTTP_API_KEY=
# EMAIL_FROM_ADDRESS=LiteTavern <no-reply@your-domain.example>
# EMAIL_HTTP_TIMEOUT_MS=10000

# ===== LiteTavern client (build-time, apps/web) =====
# Where the static client finds LiteTavern Cloud. Leave unset for same-origin.
# Also added to the built page's CSP connect-src.
# VITE_CLOUD_BASE_URL=https://cloud.your-domain.example
# Sub-path deployments (e.g. GitHub Pages project sites):
# VITE_BASE_PATH=/LiteTavern/
