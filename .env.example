# PomChat API
NODE_ENV=
HOST=
PORT=
LOG_LEVEL=
POMCHAT_WEB_ORIGIN=
POMCHAT_DATA_DIR=
POMCHAT_ASSET_DIR=

# Model requests are sent through the Cloudflare Worker when both values are set.
POMCHAT_MODEL_PROXY_URL=
# Secret: configure only in the backend service secret store.
POMCHAT_MODEL_PROXY_TOKEN=

# Official quota stays disabled until a real provider secret is configured in Cloudflare.
POMCHAT_PLATFORM_ENABLED=
POMCHAT_PLATFORM_PROVIDER=
POMCHAT_PLATFORM_MODEL=
POMCHAT_PLATFORM_BASE_URL=
POMCHAT_PLATFORM_DAILY_TOKEN_QUOTA=

# Cloudflare Worker non-secret variables
BACKEND_ORIGIN=
POMCHAT_WEB_ORIGIN=

# Cloudflare Worker secrets (never expose through VITE_* variables)
POMCHAT_MODEL_PROXY_TOKEN=
POMCHAT_PLATFORM_API_KEY=
