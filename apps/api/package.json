{
  "name": "@pomchat/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "backup": "tsx src/scripts/backup-cli.ts backup",
    "verify-backup": "tsx src/scripts/backup-cli.ts verify",
    "restore": "tsx src/scripts/backup-cli.ts restore",
    "prune-backups": "tsx src/scripts/backup-cli.ts prune",
    "test": "vitest run src --no-file-parallelism",
    "test:coverage": "vitest run src --coverage --no-file-parallelism"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "latest",
    "@ai-sdk/google": "latest",
    "@ai-sdk/openai-compatible": "latest",
    "@fastify/cookie": "latest",
    "@fastify/cors": "latest",
    "@fastify/multipart": "latest",
    "@pomchat/contracts": "0.1.0",
    "@pomchat/database": "0.1.0",
    "ai": "latest",
    "fastify": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "tsx": "latest",
    "vitest": "latest"
  }
}
