{
  "name": "litetavern",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @litetavern/web",
    "build": "npm run build --workspaces --if-present",
    "test": "npm-run-all test:workspaces test:deployment",
    "test:workspaces": "npm run test --workspaces --if-present",
    "test:deployment": "node --test scripts/validate-deployment-env.test.mjs scripts/internal-api.test.mjs",
    "test:coverage": "npm run test:coverage --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "check": "npm-run-all typecheck lint test build"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@eslint/js": "latest",
    "eslint": "latest",
    "npm-run-all": "latest",
    "typescript": "latest",
    "typescript-eslint": "latest"
  }
}
